# SwipeRide Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/swiperide or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/swiperide

# Redis Configuration (for driver live location cache & OTP TTL)
REDIS_URL=redis://127.0.0.1:6379

# JSON Web Token (JWT) Configuration
JWT_SECRET=super_secret_jwt_key_swiperide_production_change_me
JWT_EXPIRES_IN=30d

# Pricing & Fare Engine (Naira ₦)
BASE_FARE=300
COST_PER_KM=150

# Google Maps API Configuration (Optional - Haversine fallback active when empty)
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_DISTANCE_MATRIX_URL=https://maps.googleapis.com/maps/api/distancematrix/json

# Paystack Payment Gateway (Optional)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Service (Nodemailer - Optional, OTP will log to console in dev if empty)
EMAIL_USER=
EMAIL_PASS=

# Twilio SMS Service (Optional, OTP will log to console in dev if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Admin SDK (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Security & Verification Flags
ENFORCE_VERIFICATION=false
